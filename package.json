{
  "name": "cti-conecta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/check-book.mjs && node scripts/check-apostilas.mjs && tsc -b && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run && node scripts/check-sw.mjs",
    "typecheck": "tsc -b",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "test:e2e": "playwright test",
    "predev": "node scripts/prepare-pdf.mjs",
    "prebuild": "node scripts/prepare-pdf.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.5.438",
    "qrcode-generator": "^2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.163.0"
  }
}
